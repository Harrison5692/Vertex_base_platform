# Copy to .env and fill in per-deployment values. Never commit the real .env.

APP_NAME="Vertex Base API"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/vertex_base

CORS_ORIGINS=["http://localhost:5173"]

SECRET_KEY=change-me-in-every-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payments (retail vertical) — leave both unset to keep the default
# ManualPaymentProvider (no external calls, records payment_method as
# given). Fill in Stripe test keys to enable real card charging in
# test mode (free, no real money moves): https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
